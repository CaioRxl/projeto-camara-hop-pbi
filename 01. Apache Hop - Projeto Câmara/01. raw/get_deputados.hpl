<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>get_deputados</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Carrega os deputados em exercicio em raw.deputados.</description>
    <extended_description>Traz codigo, nome, partido, estado, legislatura, foto e e-mail de cada
deputado com mandato ativo no momento da carga.

Precisa rodar antes do get_despesas: e desta tabela que ele tira a lista de
quem consultar e a legislatura corrente. Rodando fora de ordem, o de despesas
usa o que sobrou da execucao anterior.

Legislatura e o periodo de mandato. O numero importa porque o fluxo de
despesas o usa para pedir so os gastos do mandato corrente, em vez do
historico inteiro.

Carga full. A tabela e truncada antes de gravar.</extended_description>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <pipeline_status>0</pipeline_status>
    <parameters>
      <parameter>
        <name>P_URL_DADOS_ABERTOS_CAMARA</name>
        <default_value>${P_URL_BASE_DADOS_ABERTOS_CAMARA}/deputados</default_value>
        <description>Endereco completo da lista de deputados. A primeira parte vem da configuracao do projeto.</description>
      </parameter>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/08/05 21:25:06.249</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/08/07 17:00:00.000</modified_date>
  </info>
  <notepads>
  </notepads>
  <order>
    <hop>
      <from>1. Montar o endereço</from>
      <to>2. Chamar a API</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>2. Chamar a API</from>
      <to>3. Abrir a resposta</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>3. Abrir a resposta</from>
      <to>4. Separar um deputado por linha</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>4. Separar um deputado por linha</from>
      <to>5. Renomear as colunas</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>5. Renomear as colunas</from>
      <to>6. Gravar em raw.deputados</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>1. Montar o endereço</name>
    <type>GetVariable</type>
    <description>Monta a URL a ser consultada.

O endereço base fica em project-config.json, não escrito à mão aqui. Se a Câmara mudar o domínio, troca-se em um lugar só.</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields>
      <field>
        <currency/>
        <decimal/>
        <format/>
        <group/>
        <length>-1</length>
        <name>V_URL_BASE</name>
        <precision>-1</precision>
        <trim_type>none</trim_type>
        <type>String</type>
        <variable>${P_URL_DADOS_ABERTOS_CAMARA}</variable>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>96</xloc>
      <yloc>144</yloc>
    </GUI>
  </transform>
  <transform>
    <name>2. Chamar a API</name>
    <type>Rest</type>
    <description>Faz a requisição e guarda a resposta inteira no campo result.

Uma única chamada traz todos os deputados. Não há paginação a tratar aqui.</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <applicationType>JSON</applicationType>
    <bodyField/>
    <connectionTimeout>15000</connectionTimeout>
    <connection_name/>
    <dynamicMethod>N</dynamicMethod>
    <headers>
</headers>
    <httpLogin/>
    <httpPassword/>
    <ignoreSsl>N</ignoreSsl>
    <matrixParameters>
</matrixParameters>
    <method>GET</method>
    <methodFieldName/>
    <parameters>
</parameters>
    <preemptive>N</preemptive>
    <proxyHost/>
    <proxyPort/>
    <readTimeout>30000</readTimeout>
    <result>
      <code/>
      <name>result</name>
      <response_header/>
      <response_time/>
    </result>
    <trustStoreFile/>
    <trustStorePassword>Encrypted </trustStorePassword>
    <url/>
    <urlField>V_URL_BASE</urlField>
    <urlInField>Y</urlInField>
    <attributes/>
    <GUI>
      <xloc>272</xloc>
      <yloc>144</yloc>
    </GUI>
  </transform>
  <transform>
    <name>3. Abrir a resposta</name>
    <type>JsonInput</type>
    <description>Isola o nó "dados" da resposta.

A API também devolve um bloco "links" com atalhos de paginação, que aqui não serve.</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <include>N</include>
    <include_field/>
    <rownum>N</rownum>
    <addresultfile>N</addresultfile>
    <readurl>N</readurl>
    <removeSourceField>Y</removeSourceField>
    <IsIgnoreEmptyFile>N</IsIgnoreEmptyFile>
    <doNotFailIfNoFile>Y</doNotFailIfNoFile>
    <ignoreMissingPath>Y</ignoreMissingPath>
    <defaultPathLeafToNull>Y</defaultPathLeafToNull>
    <rownum_field/>
    <file>
      <name/>
      <filemask/>
      <exclude_filemask/>
      <file_required>N</file_required>
      <include_subfolders>N</include_subfolders>
    </file>
    <fields>
      <field>
        <name>dados</name>
        <path>$.dados</path>
        <type>String</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
        <repeat>N</repeat>
      </field>
    </fields>
    <limit>0</limit>
    <IsInFields>Y</IsInFields>
    <IsAFile>N</IsAFile>
    <valueField>result</valueField>
    <shortFileFieldName/>
    <pathFieldName/>
    <hiddenFieldName/>
    <lastModificationTimeFieldName/>
    <uriNameFieldName/>
    <rootUriNameFieldName/>
    <extensionFieldName/>
    <sizeFieldName/>
    <attributes/>
    <GUI>
      <xloc>448</xloc>
      <yloc>144</yloc>
    </GUI>
  </transform>
  <transform>
    <name>4. Separar um deputado por linha</name>
    <type>JsonInput</type>
    <description>Quebra a lista em uma linha por deputado.

Entra uma linha com tudo agrupado, saem várias com código, nome, partido, estado, legislatura, foto e e-mail.</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <include>N</include>
    <include_field/>
    <rownum>N</rownum>
    <addresultfile>N</addresultfile>
    <readurl>N</readurl>
    <removeSourceField>Y</removeSourceField>
    <IsIgnoreEmptyFile>N</IsIgnoreEmptyFile>
    <doNotFailIfNoFile>Y</doNotFailIfNoFile>
    <ignoreMissingPath>Y</ignoreMissingPath>
    <defaultPathLeafToNull>Y</defaultPathLeafToNull>
    <rownum_field/>
    <file>
      <name/>
      <filemask/>
      <exclude_filemask/>
      <file_required>N</file_required>
      <include_subfolders>N</include_subfolders>
    </file>
    <fields>
      <field>
        <name>id</name>
        <path>$.*.id</path>
        <type>String</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
        <repeat>N</repeat>
      </field>
      <field>
        <name>uri</name>
        <path>$.*.uri</path>
        <type>String</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
        <repeat>N</repeat>
      </field>
      <field>
        <name>nome</name>
        <path>$.*.nome</path>
        <type>String</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
        <repeat>N</repeat>
      </field>
      <field>
        <name>siglaPartido</name>
        <path>$.*.siglaPartido</path>
        <type>String</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
        <repeat>N</repeat>
      </field>
      <field>
        <name>uriPartido</name>
        <path>$.*.uriPartido</path>
        <type>String</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
        <repeat>N</repeat>
      </field>
      <field>
        <name>siglaUf</name>
        <path>$.*.siglaUf</path>
        <type>String</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
        <repeat>N</repeat>
      </field>
      <field>
        <name>idLegislatura</name>
        <path>$.*.idLegislatura</path>
        <type>String</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
        <repeat>N</repeat>
      </field>
      <field>
        <name>urlFoto</name>
        <path>$.*.urlFoto</path>
        <type>String</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
        <repeat>N</repeat>
      </field>
      <field>
        <name>email</name>
        <path>$.*.email</path>
        <type>String</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
        <repeat>N</repeat>
      </field>
    </fields>
    <limit>0</limit>
    <IsInFields>Y</IsInFields>
    <IsAFile>N</IsAFile>
    <valueField>dados</valueField>
    <shortFileFieldName/>
    <pathFieldName/>
    <hiddenFieldName/>
    <lastModificationTimeFieldName/>
    <uriNameFieldName/>
    <rootUriNameFieldName/>
    <extensionFieldName/>
    <sizeFieldName/>
    <attributes/>
    <GUI>
      <xloc>656</xloc>
      <yloc>144</yloc>
    </GUI>
  </transform>
  <transform>
    <name>5. Renomear as colunas</name>
    <type>SelectValues</type>
    <description>Aplica os nomes usados no banco e converte id_legislatura para inteiro.

Prefixos do projeto: id_ identificador, sg_ sigla, nm_ nome, ds_ texto livre, uri_ endereço.

A conversão de id_legislatura importa: o get_despesas faz MAX sobre essa coluna, e MAX em texto ordenaria "9" acima de "57".</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields>
      <field>
        <name>id</name>
        <rename>id_deputado</rename>
      </field>
      <field>
        <name>uri</name>
        <rename>uri_deputado</rename>
      </field>
      <field>
        <name>nome</name>
        <rename>nm_deputado</rename>
      </field>
      <field>
        <name>siglaPartido</name>
        <rename>sg_partido</rename>
      </field>
      <field>
        <name>uriPartido</name>
        <rename>uri_partido</rename>
      </field>
      <field>
        <name>siglaUf</name>
        <rename>sg_uf</rename>
      </field>
      <field>
        <name>idLegislatura</name>
        <rename>id_legislatura</rename>
      </field>
      <field>
        <name>urlFoto</name>
        <rename>ds_url_foto</rename>
      </field>
      <field>
        <name>email</name>
        <rename>ds_email</rename>
      </field>
      <select_unspecified>N</select_unspecified>
      <meta>
        <name>id_legislatura</name>
        <rename>id_legislatura</rename>
        <type>Integer</type>
        <length>-2</length>
        <precision>-2</precision>
        <conversion_mask/>
        <date_format_lenient>false</date_format_lenient>
        <date_format_locale/>
        <date_format_timezone/>
        <lenient_string_to_number>false</lenient_string_to_number>
        <encoding/>
        <decimal_symbol/>
        <grouping_symbol/>
        <currency_symbol/>
        <storage_type/>
      </meta>
    </fields>
    <attributes/>
    <GUI>
      <xloc>880</xloc>
      <yloc>144</yloc>
    </GUI>
  </transform>
  <transform>
    <name>6. Gravar em raw.deputados</name>
    <type>TableOutput</type>
    <description>Grava em raw.deputados. A tabela é truncada antes, então cada execução substitui o conteúdo.

Como a API só devolve quem está em exercício, a tabela reflete a composição da Casa no momento da carga. É daqui que o get_despesas tira a lista de quem consultar.</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <commit>1000</commit>
    <connection>supabase</connection>
    <fields>
      <field>
        <column_name>id_deputado</column_name>
        <stream_name>id_deputado</stream_name>
      </field>
      <field>
        <column_name>uri_deputado</column_name>
        <stream_name>uri_deputado</stream_name>
      </field>
      <field>
        <column_name>nm_deputado</column_name>
        <stream_name>nm_deputado</stream_name>
      </field>
      <field>
        <column_name>sg_partido</column_name>
        <stream_name>sg_partido</stream_name>
      </field>
      <field>
        <column_name>uri_partido</column_name>
        <stream_name>uri_partido</stream_name>
      </field>
      <field>
        <column_name>sg_uf</column_name>
        <stream_name>sg_uf</stream_name>
      </field>
      <field>
        <column_name>id_legislatura</column_name>
        <stream_name>id_legislatura</stream_name>
      </field>
      <field>
        <column_name>ds_url_foto</column_name>
        <stream_name>ds_url_foto</stream_name>
      </field>
      <field>
        <column_name>ds_email</column_name>
        <stream_name>ds_email</stream_name>
      </field>
    </fields>
    <ignore_errors>N</ignore_errors>
    <only_when_have_rows>N</only_when_have_rows>
    <partitioning_daily>N</partitioning_daily>
    <partitioning_enabled>N</partitioning_enabled>
    <partitioning_monthly>Y</partitioning_monthly>
    <return_keys>N</return_keys>
    <schema>raw</schema>
    <specify_fields>Y</specify_fields>
    <table>deputados</table>
    <tablename_in_field>N</tablename_in_field>
    <tablename_in_table>Y</tablename_in_table>
    <truncate>Y</truncate>
    <use_batch>Y</use_batch>
    <attributes/>
    <GUI>
      <xloc>1104</xloc>
      <yloc>144</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
  <attributes/>
</pipeline>
