  <transform>
    <name>2. Pegar endereço e tamanho de página</name>
    <type>GetVariable</type>
    <description>Anexa a cada linha o endereço base da API, o tamanho de página e o intervalo de log.

As caixas que montam endereços e calculam fórmulas só trabalham com colunas, não com configuração do projeto. Esta caixa faz a ponte.</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields>
      <field>
        <length>-1</length>
        <name>V_URL_BASE</name>
        <precision>-1</precision>
        <trim_type>none</trim_type>
        <type>String</type>
        <variable>${P_URL_BASE_DADOS_ABERTOS_CAMARA}</variable>
      </field>
      <field>
        <length>-1</length>
        <name>V_ITENS</name>
        <precision>-1</precision>
        <trim_type>none</trim_type>
        <type>String</type>
        <variable>${P_ITENS_POR_PAGINA}</variable>
      </field>
      <field>
        <length>-1</length>
        <name>V_INTERVALO_LOG</name>
        <precision>-1</precision>
        <trim_type>none</trim_type>
        <type>String</type>
        <variable>${P_INTERVALO_LOG_PAGINAS}</variable>
      </field>
    </fields>
