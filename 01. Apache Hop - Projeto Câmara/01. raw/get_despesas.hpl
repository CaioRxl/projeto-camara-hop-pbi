  <transform>
    <name>Marcar o intervalo de log</name>
    <type>Janino</type>
    <description>Calcula o resto da divisão do número da página pelo intervalo de log.

Resto zero significa que aquela página é um marco e merece uma linha no log. Todas as outras seguem direto.</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <formula>
      <field_name>marco_log</field_name>
      <formula_string>nr_pagina_lida.longValue() % Integer.parseInt(V_INTERVALO_LOG)</formula_string>
      <value_type>Integer</value_type>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <replace_field/>
    </formula>
    <attributes/>
    <GUI>
      <xloc>672</xloc>
      <yloc>592</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Separar os marcos</name>
    <type>FilterRows</type>
    <description>Manda as páginas de marco para o log e todo o resto direto para a caixa 11.

Nada é descartado: os dois caminhos voltam a se juntar na caixa 11.</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <compare>
      <condition>
        <conditions>
</conditions>
        <function>=</function>
        <leftvalue>marco_log</leftvalue>
        <negated>N</negated>
        <operator>-</operator>
        <value>
          <isnull>N</isnull>
          <length>-1</length>
          <name>constante</name>
          <precision>0</precision>
          <text>0</text>
          <type>Integer</type>
        </value>
      </condition>
    </compare>
    <send_false_to>11. Separar uma despesa por linha</send_false_to>
    <send_true_to>Log: páginas baixadas</send_true_to>
    <attributes/>
    <GUI>
      <xloc>848</xloc>
      <yloc>592</yloc>
    </GUI>
  </transform>
