    <attributes/>
    <GUI>
      <xloc>352</xloc>
      <yloc>176</yloc>
    </GUI>
  </transform>
  <transform>
    <name>3. Gravar em refined.fato_ocupacao</name>
    <type>TableOutput</type>
    <description>Grava em refined.fato_ocupacao. A tabela é truncada antes, então cada execução substitui o conteúdo.

Como toda fato deste modelo, não há chave estrangeira declarada para a dimensão: os pipelines gravam com truncate e o Postgres recusa truncate em tabela referenciada por FK. A consulta que verifica as ligações está no fim do 02. refined/ddl.sql.</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <commit>1000</commit>
    <connection>supabase</connection>
    <fields>
      <field>
        <column_name>id_ocupacao</column_name>
        <stream_name>id_ocupacao</stream_name>
      </field>
      <field>
        <column_name>id_deputado</column_name>
        <stream_name>id_deputado</stream_name>
      </field>
      <field>
        <column_name>ds_titulo</column_name>
        <stream_name>ds_titulo</stream_name>
      </field>
      <field>
        <column_name>nm_entidade</column_name>
        <stream_name>nm_entidade</stream_name>
      </field>
      <field>
        <column_name>sg_uf_entidade</column_name>
